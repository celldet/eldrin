# playeldrin.com: clean URLs (no .html), HTTPS, apex domain.
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://playeldrin.com%{REQUEST_URI} [L,R=301]

# www -> apex
RewriteCond %{HTTP_HOST} ^www\.playeldrin\.com$ [NC]
RewriteRule ^ https://playeldrin.com%{REQUEST_URI} [L,R=301]

# /index.html and /index -> /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [L,R=301]

# /page.html -> /page (only for real files)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?]
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1 [L,R=301]

# /page/ -> /page
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [L,R=301]

# /page -> page.html (internal)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Never serve dotfiles (but keep .well-known)
<IfModule mod_rewrite.c>
RewriteRule ^\.(?!well-known/) - [F,L]
</IfModule>
<FilesMatch "^(CNAME|\.nojekyll)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
AddType font/ttf .ttf
AddType image/webp .webp
AddDefaultCharset UTF-8
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml font/ttf
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType text/css "access plus 1 week"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
